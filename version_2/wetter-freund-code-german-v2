// =======================================================
// logMessage() - Speichert NUR den Index
// Text wird NICHT gespeichert, sondern bei Ausgabe erzeugt
// =======================================================
void logMessage(uint8_t level, uint8_t messageIndex) {
  if (!cfg.logWeblog && level != LOG_ERROR) return;
  
  logBuffer[logIndex].timestamp = time(nullptr);
  logBuffer[logIndex].level = level;
  logBuffer[logIndex].msgIndex = messageIndex;  // <- NUR Index!
  
  logIndex = (logIndex + 1) % LOG_BUFFER_SIZE;
  if (logCount < LOG_BUFFER_SIZE) logCount++;
  // Syslog senden
  if (cfg.logSyslog) {
    sendSyslog(level, getText(messageIndex));
  }
  hasNewLogs = true;
}

// ═══════════════════════════════════════════════════════
// Syslog senden (RFC 5424)
// ═══════════════════════════════════════════════════════
void sendSyslog(uint8_t level, const char* message) {
  if (!cfg.logSyslog || cfg.syslogServer[0] == '\0') return;
  
  String serverStr = String(cfg.syslogServer);
  String host = serverStr;
  int port = 514;
  
  int colonPos = serverStr.indexOf(':');
  if (colonPos > 0) {
    host = serverStr.substring(0, colonPos);
    port = serverStr.substring(colonPos + 1).toInt();
    if (port <= 0 || port > 65535) port = 514;
  }
  
  // Syslog Severity: INFO=6, WARN=4, ERROR=3
  int severity = (level == LOG_INFO) ? 6 : (level == LOG_WARN) ? 4 : 3;
  int facility = 16; // local0
  int priority = (facility * 8) + severity;
  
  String hostname = "ESP-BME280";
  String appName = "weather";
  
  String syslogMsg = "<" + String(priority) + ">1 ";
  syslogMsg += utcTimeISO8601() + " ";
  syslogMsg += hostname + " ";
  syslogMsg += appName + " - - - ";
  syslogMsg += message;
  
  udpClient.beginPacket(host.c_str(), port);
  udpClient.write(syslogMsg.c_str());
  udpClient.endPacket();
}

