    case  3: return MSG_MQTT_ERROR_UNAVAILABLE;
    case  4: return MSG_MQTT_ERROR_AUTH;
    case  5: return MSG_MQTT_ERROR_UNAUTHORIZED;
    default: return MSG_MQTT_ERROR_UNKNOWN;
  }
}

void connectMQTT() {
  if (!cfg.mqttActive || cfg.mqttBroker[0] == '\0') {
    mqttStatus = MQTT_STATUS_DISCONNECTED;
    mqttLastError = "MQTT nicht konfiguriert";
    return;
  }

  unsigned long now = millis();

  // Check ob max Versuche erreicht
  if (mqttReconnectAttempts >= MQTT_MAX_RECONNECT_ATTEMPTS) {
    cfg.mqttActive = false;
    cfgSave();
    mqttStatus = MQTT_STATUS_DISCONNECTED;
    mqttLastError = "Max Reconnect-Versuche erreicht";
    logMessage(LOG_ERROR, MSG_MQTT_MAX_RETRIES);
    return;
  }

  // Check ob genug Zeit vergangen ist
  if (now - mqttLastConnectAttempt < mqttReconnectDelay) {
    return;
  }

  mqttLastConnectAttempt = now;
  mqttReconnectAttempts++;

  String brokerStr = String(cfg.mqttBroker);
  String host = brokerStr;
  int port = 1883;
  
  int colonPos = brokerStr.indexOf(':');
  if (colonPos > 0) {
    host = brokerStr.substring(0, colonPos);
    port = brokerStr.substring(colonPos + 1).toInt();
    if (port <= 0 || port > 65535) port = 1883;
  }

  mqttStatus = MQTT_STATUS_CONNECTING;
  mqtt.setServer(host.c_str(), port);
  mqtt.setBufferSize(512);

  bool connected = false;
  if (cfg.mqttUser[0] != '\0') {
    connected = mqtt.connect("ESP-BME280", cfg.mqttUser, cfg.mqttPass);
  } else {
    connected = mqtt.connect("ESP-BME280");
  }

  if (connected) {
    mqttStatus = MQTT_STATUS_CONNECTED;
    mqttLastError = "";
    mqttReconnectAttempts = 0;           // ← NEU! Counter zurücksetzen
    mqttReconnectDelay = 5000;           // ← NEU! Delay zurücksetzen
    logMessage(LOG_INFO, MSG_MQTT_CONNECTED);
  } else {
    mqttStatus = MQTT_STATUS_DISCONNECTED;
    int state = mqtt.state();
    mqttLastError = getMQTTErrorText(state);
    logMessage(LOG_ERROR, getMQTTErrorIndex(state));
    
    // Delay verdoppeln für nächsten Versuch
    mqttReconnectDelay *= 2;             // ← NEU! 5s → 10s → 20s → 40s → 80s
  }
}

// =======================================================
// buildLogJSON() - Baut JSON aus neuen Log-Einträgen
// Wird nur aufgerufen wenn MQTT-Log aktiv ist
// =======================================================
String buildLogJSON() {
  if (logCount == 0) return "";
  if (lastSentLogIndex == logIndex && logCount < LOG_BUFFER_SIZE) return "";
  
  StaticJsonDocument<512> doc;
  JsonArray entries = doc.createNestedArray("logs");
  
  int count = 0;
  int maxEntries = 10;  // Max 10 Einträge pro MQTT-Nachricht
  
  // Vom letzten gesendeten Index bis zum aktuellen
  for (int i = 0; i < logCount && count < maxEntries; i++) {
    int idx = (lastSentLogIndex + i) % LOG_BUFFER_SIZE;
    if (idx == logIndex) break;  // Aktueller Index erreicht
    
    LogEntry& entry = logBuffer[idx];
    JsonObject obj = entries.createNestedObject();
    
    obj["ts"] = entry.timestamp;
    obj["lvl"] = entry.level;
    obj["msg"] = getText(entry.msgIndex);
    
    count++;
  }
  
  if (count == 0) return "";
  
  lastSentLogIndex = (lastSentLogIndex + count) % LOG_BUFFER_SIZE;
  
  String output;
  serializeJson(doc, output);
  return output;
}

void publishMQTT() {
  if (mqttStatus != MQTT_STATUS_CONNECTED) return;

  float temp  = bme.readTemperature();
  float hum   = bme.readHumidity();
  float press = bme.readPressure() / 100.0f;
  float dew   = dewPoint(temp, hum);
  int trend   = calcBaroTrend();
  int warning = calculateWeatherWarning(temp, hum, dew, trend);

  String ts = utcTimeISO8601();

  struct MQTTParam {
    const char* topic;
    String value;
    uint8_t paramIndex;
  };

  MQTTParam params[7] = {
    {"bme280/temperature", String(temp, 2) + "|" + ts, 0},
    {"bme280/humidity", String(hum, 2) + "|" + ts, 1},
    {"bme280/pressure", String(press, 2) + "|" + ts, 2},
    {"bme280/barometer", String(trend) + "|" + ts, 3},
    {"bme280/dewpoint", String(dew, 2) + "|" + ts, 4},
    {"bme280/warning", String(warning) + "|" + getWarningText(warning) + "|" + ts, 5},
    {"bme280/log", "", 6}
  };

for (int i = 0; i < 7; i++) {
    if (cfg.mqttParams[i] >= 1) {
      bool retain = (cfg.mqttParams[i] == 2);
      
      // Sonderbehandlung für Log (Index 6)
      if (i == 6) {
        String logPayload = buildLogJSON();
        if (logPayload.length() > 0) {
          mqtt.publish(params[i].topic, logPayload.c_str(), retain);
        }
      } else {
        mqtt.publish(params[i].topic, params[i].value.c_str(), retain);
      }
    }
  }
}

bool sendHAOSDiscovery() {
  if (mqttStatus != MQTT_STATUS_CONNECTED) return false;

  String deviceJson = "\"device\":{";
  deviceJson += "\"identifiers\":[\"" + WiFi.macAddress() + "\"],";
  deviceJson += "\"name\":\"ESP-BME280 Sensor\",";
  deviceJson += "\"model\":\"ESP-02S + BME280\",";
  deviceJson += "\"manufacturer\":\"Custom\"";
  deviceJson += "}";

  struct Sensor {
    const char* component;
    const char* objectId;
    const char* name;
    const char* stateTopic;
    const char* unit;
    const char* deviceClass;
    const char* icon;
    const char* valueTemplate;
  };

  Sensor sensors[6] = {
    {"sensor", "bme280_temperature", "Temperatur", "bme280/temperature", "°C", "temperature", "mdi:thermometer", "{{ value.split('|')[0] }}"},
    {"sensor", "bme280_humidity", "Luftfeuchtigkeit", "bme280/humidity", "%", "humidity", "mdi:water-percent", "{{ value.split('|')[0] }}"},
    {"sensor", "bme280_pressure", "Luftdruck", "bme280/pressure", "hPa", "pressure", "mdi:gauge", "{{ value.split('|')[0] }}"},
    {"sensor", "bme280_barometer", "Barometerstand", "bme280/barometer", "", "", "mdi:trending-up", "{{ value.split('|')[0] | int }}"},
    {"sensor", "bme280_dewpoint", "Taupunkt", "bme280/dewpoint", "°C", "temperature", "mdi:water", "{{ value.split('|')[0] }}"},
    {"sensor", "bme280_warning", "Wetterwarnung", "bme280/warning", "", "", "mdi:alert", "{{ value.split('|')[0] | int }}"}
  };

  bool allSuccess = true;
  int successCount = 0;

  for (int i = 0; i < 6; i++) {
    String configTopic = "homeassistant/" + String(sensors[i].component) + "/" + String(sensors[i].objectId) + "/config";
    
    String payload = "{\n";
    payload += "  \"name\":\"" + String(sensors[i].name) + "\",\n";
    payload += "  \"unique_id\":\"" + String(sensors[i].objectId) + "_" + WiFi.macAddress() + "\",\n";
    payload += "  \"state_topic\":\"" + String(sensors[i].stateTopic) + "\",\n";
    payload += "  \"value_template\":\"" + String(sensors[i].valueTemplate) + "\",\n";
    
    if (strlen(sensors[i].unit) > 0) {
      payload += "  \"unit_of_measurement\":\"" + String(sensors[i].unit) + "\",\n";
    }
    if (strlen(sensors[i].deviceClass) > 0) {
      payload += "  \"device_class\":\"" + String(sensors[i].deviceClass) + "\",\n";
    }
    if (strlen(sensors[i].icon) > 0) {
      payload += "  \"icon\":\"" + String(sensors[i].icon) + "\",\n";
    }
    
    payload += "  " + deviceJson + "\n";
    payload += "}";

    bool success = mqtt.publish(configTopic.c_str(), payload.c_str(), true);
    
    if (success) {
      successCount++;
    } else {
      allSuccess = false;
    }
    
    delay(100);
  }

  if (allSuccess) {
    logMessage(LOG_INFO, MSG_HAOS_DISCOVERY_SUCCESS);
  } else {
    logMessage(LOG_ERROR, MSG_HAOS_DISCOVERY_FAILED);
  }

  return allSuccess;
}

