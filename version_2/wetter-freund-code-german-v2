// ═══════════════════════════════════════════════════════
// Setup
// ═══════════════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\n\n=== ESP-BME280 START ===");
  Serial.print("Config Size: ");
  Serial.println(sizeof(Config));

  pinMode(BUTTON_PIN, INPUT_PULLUP);
    
  EEPROM.begin(EEPROM_SIZE);
  
  Wire.begin(SDA_PIN, SCL_PIN);
  bme.begin(0x76);

  // Config laden oder Defaults
  if (!cfgLoad()) {
    Serial.println("⚠️ Keine gültige Config → Defaults setzen");
    cfgSetDefaults();
    cfgSave();
  }

  logMessage(LOG_INFO, MSG_SYSTEM_START);

  // WLAN oder AP?
  if (cfg.ssid[0] == '\0') {
    Serial.println("📡 Keine SSID → AP-Modus");
    startAccessPoint();
  } else {
    if (!connectToWiFi()) {
      Serial.println("❌ WLAN fehlgeschlagen → AP-Modus");
      startAccessPoint();
    } else {
      setupTime();
      
      // mDNS starten
      if (MDNS.begin("wetter-freund")) {
        Serial.println("✅ mDNS gestartet: http://wetter-freund.local");
        MDNS.addService("http", "tcp", 80);
      } else {
        Serial.println("❌ mDNS Start fehlgeschlagen!");
      }
      
      setupOTA();
      connectMQTT();
    }
  }

  // Webserver Routes
  webServer.on("/", handleRoot);
  webServer.on("/tab/daten", handleTabDaten);
  webServer.on("/tab/einstellungen", handleTabEinstellungen);
  webServer.on("/tab/system", handleTabSystem);
  webServer.on("/tab/logs", handleTabLogs);
  webServer.on("/mqtt",   HTTP_GET,  handleMQTTPage);
  webServer.on("/mqtt",   HTTP_POST, handleMQTT);
  webServer.on("/json",   HTTP_GET,  handleJSON);
  webServer.on("/system", HTTP_GET,  handleSystemPage);
  webServer.on("/eraseConfig", handleEraseConfig);
  webServer.on("/log",    HTTP_GET,  handleLogPage);
  webServer.on("/api/mqtt-status", HTTP_GET, handleMQTTStatus);
  webServer.on("/api/log-status", HTTP_GET, handleLogStatus);
  webServer.on("/update", HTTP_POST, handleUpdateDone, handleUpdate);
  webServer.on("/saveMqtt", HTTP_POST, handleSaveMqtt);
  webServer.on("/saveWifi", HTTP_POST, handleSaveWifi);  // ← NEU!
  webServer.on("/saveLocation", HTTP_POST, handleSaveLocation);
  webServer.on("/saveLogging", HTTP_POST, handleSaveLogging);

  webServer.begin();
  logMessage(LOG_INFO, MSG_WEBSERVER_START);
  
  Serial.println("✅ System bereit!");
  if (WiFi.getMode() == WIFI_AP) {
    Serial.println("📡 WebUI: http://10.10.10.1");
  } else {
    Serial.println("📡 WebUI: http://" + WiFi.localIP().toString());
  }
}

// ═══════════════════════════════════════════════════════
// Loop
// ═══════════════════════════════════════════════════════
unsigned long lastMQTT = 0;
unsigned long lastBaroUpdate = 0;

void loop() {
  // 🚨 NOTFALL-TASTER: EEPROM löschen + AP-Modus
  if (digitalRead(BUTTON_PIN) == LOW) {
    cfgEraseAll();
    delay(500);
    ESP.restart();
  }
  
  updateCPUUsage();
  webServer.handleClient();
  
  ArduinoOTA.handle();
  MDNS.update();

  if (millis() - lastBaroUpdate > 5000UL || lastBaroUpdate == 0) {
    float press = bme.readPressure() / 100.0f;
    updateBarometer(press);
    lastBaroUpdate = millis();
  }

  if (cfg.mqttActive) {
    if (mqttStatus != MQTT_STATUS_CONNECTED) {
      connectMQTT();
    }
    
    if (mqttStatus == MQTT_STATUS_CONNECTED) {
      mqtt.loop();
      
      if (millis() - lastMQTT > 60000UL) {
        publishMQTT();
        lastMQTT = millis();
      }
    }
  }
  delay(LOOP_DELAY);
}
