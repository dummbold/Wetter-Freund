#define EEPROM_SIZE 512

struct __attribute__((packed)) Config {
  char     ssid[33];
  char     pass[65];
  char     mqttBroker[65];
  char     mqttUser[33];
  char     mqttPass[65];
  uint8_t  mqttActive;
  uint8_t  mqttParams[10];      // ✅ 8 → 10 (für 9 Parameter + Reserve)
  float    altitude;
  float    latitude;
  float    longitude;
  uint8_t  logWeblog;
  uint8_t  logSyslog;
  char     syslogServer[65];
  uint8_t  logMqtt;
  uint16_t crc;
};

constexpr size_t CFG_LEN_NO_CRC = offsetof(Config, crc);

Config cfg;

uint16_t crc16(const uint8_t* data, size_t len) {
  uint16_t crc = 0xFFFF;
  for (size_t i = 0; i < len; i++) {
    crc ^= data[i];
    for (uint8_t j = 0; j < 8; j++) {
      crc = (crc & 1) ? (crc >> 1) ^ 0xA001 : (crc >> 1);
    }
  }
  return crc;
}

void cfgSetDefaults() {
  memset(&cfg, 0, sizeof(cfg));
  
  // ✅ WLAN leer = AP-Modus beim nächsten Boot
  cfg.ssid[0] = '\0';
  cfg.pass[0] = '\0';
  
  cfg.mqttActive = 0;
  for (int i = 0; i < 10; i++) cfg.mqttParams[i] = 0;
  cfg.altitude = 0.0f;
  cfg.latitude = 0.0f;
  cfg.longitude = 0.0f;
  cfg.mqttUser[0]  = '\0';
  cfg.mqttPass[0]  = '\0';
  cfg.logWeblog = 1;
  cfg.logSyslog = 0;
  cfg.syslogServer[0] = '\0';
  cfg.crc = crc16(reinterpret_cast<const uint8_t*>(&cfg), CFG_LEN_NO_CRC);
}

bool cfgLoad() {
  if (sizeof(Config) > EEPROM_SIZE) {
    Serial.println("CONFIG TOO LARGE FOR EEPROM!");
    return false;
  }

  EEPROM.get(0, cfg);

  Serial.println("\n=== EEPROM CONFIG ===");
  Serial.print("WiFi SSID: ");     Serial.println(cfg.ssid);
  Serial.print("WiFi Pass: ");     Serial.println(cfg.pass[0] ? "***" : "(leer)");
  Serial.print("MQTT Broker: ");   Serial.println(cfg.mqttBroker);
  Serial.print("MQTT User: ");     Serial.println(cfg.mqttUser);
  Serial.print("MQTT Pass: ");     Serial.println(cfg.mqttPass[0] ? "***" : "(leer)");
  Serial.print("MQTT Active: ");   Serial.println(cfg.mqttActive);
  Serial.print("Altitude: ");      Serial.print(cfg.altitude); Serial.println(" m");
  Serial.print("Latitude: ");      Serial.println(cfg.latitude, 6);
  Serial.print("Longitude: ");     Serial.println(cfg.longitude, 6);
  Serial.print("Log Weblog: ");    Serial.println(cfg.logWeblog);
  Serial.print("Log Syslog: ");    Serial.println(cfg.logSyslog);
  Serial.print("Syslog Server: "); Serial.println(cfg.syslogServer);
  Serial.println("====================\n");

  uint16_t crcCalc = crc16(reinterpret_cast<const uint8_t*>(&cfg), CFG_LEN_NO_CRC);
  if (crcCalc != cfg.crc) {
    Serial.println("CRC CHECK FAILED!");
    return false;
  }

  return true;
}

void cfgSave() {
  cfg.crc = crc16(reinterpret_cast<const uint8_t*>(&cfg), CFG_LEN_NO_CRC);
  EEPROM.put(0, cfg);
  EEPROM.commit();
}

void cfgEraseAll() {
  Serial.println("🚨 EMERGENCY: Lösche komplettes EEPROM...");
  for (int i = 0; i < EEPROM_SIZE; i++) {
    EEPROM.write(i, 0xFF);
  }
  EEPROM.commit();
  Serial.println("✅ EEPROM gelöscht!");
}

void cfgClearMQTT() {
