// ═══════════════════════════════════════════════════════
// OTA Web-Upload Handler
// ═══════════════════════════════════════════════════════
void handleUpdate() {
  HTTPUpload& upload = webServer.upload();
  
  if (upload.status == UPLOAD_FILE_START) {
    logMessage(LOG_INFO, MSG_OTA_START);
    uint32_t maxSketchSpace = (ESP.getFreeSketchSpace() - 0x1000) & 0xFFFFF000;
    if (!Update.begin(maxSketchSpace)) {
      logMessage(LOG_ERROR, MSG_OTA_ERROR);
    }
  } else if (upload.status == UPLOAD_FILE_WRITE) {
    if (Update.write(upload.buf, upload.currentSize) != upload.currentSize) {
      logMessage(LOG_ERROR, MSG_OTA_ERROR);
    }
  } else if (upload.status == UPLOAD_FILE_END) {
    if (Update.end(true)) {
      logMessage(LOG_INFO, MSG_OTA_DONE);
    } else {
      logMessage(LOG_ERROR, MSG_OTA_ERROR);
    }
  }
}
void handleUpdateDone() {
  if (Update.hasError()) {
    webServer.send(200, "text/plain", "Update FEHLGESCHLAGEN!");
  } else {
    webServer.send(200, "text/plain", "Update ERFOLGREICH! ESP startet neu...");
    delay(1000);
    ESP.restart();
  }
}
// ═══════════════════════════════════════════════════════
// JSON Handler mit ArduinoJson
// ═══════════════════════════════════════════════════════
void handleJSON() {
  float temp  = bme.readTemperature();
  float hum   = bme.readHumidity();
  float press = bme.readPressure() / 100.0f;
  float dew   = dewPoint(temp, hum);
  int trend   = calcBaroTrend();
  int warning = calculateWeatherWarning(temp, hum, dew, trend);

  String ts = utcTimeISO8601();

  // JSON Dokument erstellen (Größe anpassen wenn nötig)
  StaticJsonDocument<1024> doc;

  doc["timestamp"] = ts;

JsonObject temperature = doc.createNestedObject("temperature");
  if (isnan(temp)) {
    temperature["value"] = nullptr;  // → wird zu "null" im JSON
  } else {
    temperature["value"] = serialized(String(temp, 2));
  }
  temperature["unit"] = "°C";

  JsonObject humidity = doc.createNestedObject("humidity");
  if (isnan(hum)) {
    humidity["value"] = nullptr;
  } else {
    humidity["value"] = serialized(String(hum, 2));
  }
  humidity["unit"] = "%";

  JsonObject pressure = doc.createNestedObject("pressure");
  if (isnan(press)) {
    pressure["value"] = nullptr;
  } else {
    pressure["value"] = serialized(String(press, 2));
  }
  pressure["unit"] = "hPa";

  // ✅ NEU: Durchschnittswerte hinzufügen
  JsonObject pressureAvg = doc.createNestedObject("pressureAvg");
  pressureAvg["current"] = !isnan(currentHourlyValue) ? currentHourlyValue : 0.0;
  pressureAvg["minus1h"] = !isnan(hourlyValue_minus1) ? hourlyValue_minus1 : 0.0;
  pressureAvg["minus2h"] = !isnan(hourlyValue_minus2) ? hourlyValue_minus2 : 0.0;
  pressureAvg["unit"] = "hPa";

  JsonObject barometer = doc.createNestedObject("barometer");
  barometer["value"] = trend;
  barometer["unit"] = "level";
  barometer["range"] = "-3 to +3";

  JsonObject dewpoint = doc.createNestedObject("dewpoint");
  if (isnan(dew)) {
    dewpoint["value"] = nullptr;
  } else {
    dewpoint["value"] = serialized(String(dew, 2));
  }
  dewpoint["unit"] = "°C";

  JsonObject warningObj = doc.createNestedObject("warning");
  warningObj["value"] = warning;
  warningObj["text"] = getWarningText(warning);

  JsonObject location = doc.createNestedObject("location");
  location["latitude"] = serialized(String(cfg.latitude, 6));
  location["longitude"] = serialized(String(cfg.longitude, 6));
  
  JsonObject altitude = location.createNestedObject("altitude");
  altitude["value"] = serialized(String(cfg.altitude, 1));
  altitude["unit"] = "m";

  // JSON als String serialisieren (schön formatiert)
  String output;
  serializeJsonPretty(doc, output);

  webServer.sendHeader("Access-Control-Allow-Origin", "*");
  webServer.send(200, "application/json", output);
}

