    chunk += "<p style='text-align:center;color:#666;'>In Einstellungen aktivieren</p>";
  } else {
    chunk += "<table><tr><th>Zeit</th><th>Level</th><th>Nachricht</th></tr>";
    webServer.sendContent(chunk);
    chunk = "";

    // Logs einzeln senden
    for (int i = 0; i < logCount; i++) {
      int idx = (logIndex - 1 - i + LOG_BUFFER_SIZE) % LOG_BUFFER_SIZE;
      LogEntry& entry = logBuffer[idx];

      time_t t = entry.timestamp;
      struct tm* tm_info = localtime(&t);
      char timeStr[20];
      if (tm_info) {
        strftime(timeStr, sizeof(timeStr), "%d.%m. %H:%M:%S", tm_info);
      } else {
        strcpy(timeStr, "??:??:??");
      }

      const char* levelStr[] = {"INFO", "WARN", "ERROR"};
      const char* levelClass[] = {"log-info", "log-warn", "log-error"};

      chunk += "<tr>";
      chunk += "<td class='timestamp'>" + String(timeStr) + "</td>";
      chunk += "<td class='" + String(levelClass[entry.level]) + "'>" + String(levelStr[entry.level]) + "</td>";
      chunk += "<td>" + String(getText(entry.msgIndex)) + "</td>";
      chunk += "</tr>";

      // Alle 5 Zeilen senden
      if (i % 5 == 4 || i == logCount - 1) {
        webServer.sendContent(chunk);
        chunk = "";
      }
    }

    chunk += "</table>";
    chunk += "<p style='text-align:center;color:#666;font-size:11px;margin-top:20px;'>ℹ️ Zeige " + String(logCount) + " von max. " + String(LOG_BUFFER_SIZE) + "</p>";
  }

  chunk += "</fieldset></div></div>";
  webServer.sendContent(chunk);
  webServer.sendContent("");
}

