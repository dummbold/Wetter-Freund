// ═══════════════════════════════════════════════════════
// CPU-Messung
// ═══════════════════════════════════════════════════════
void updateCPUUsage() {
  static unsigned long lastMeasurement = 0;
  static unsigned long loopCounter = 0;
  
  loopCounter++;
  
  unsigned long currentTime = millis();
  
  if (currentTime - lastMeasurement >= 2000) {
    unsigned long timeDiff = currentTime - lastMeasurement;
    float loopsPerSecond = (loopCounter * 1000.0) / timeDiff;
    
    Serial.print("Loops/s: ");
    Serial.print(loopsPerSecond);
    Serial.print(" | CPU: ");
    Serial.println(cpuUsage);

    // Zeit pro Loop in ms
    float timePerLoop = 1000.0 / loopsPerSecond;
    
    // Arbeitszeit = Gesamtzeit - Delay
    float workTime = timePerLoop - LOOP_DELAY;
    
    // CPU-Last = (Arbeitszeit / theoretische Arbeitszeit) × 100
    cpuUsage = (workTime / LOOP_DELAY) * 100.0;
    
    if (cpuUsage < 0) cpuUsage = 0;
    if (cpuUsage > 100) cpuUsage = 100;
    
    loopCounter = 0;
    lastMeasurement = currentTime;
  }
}

// ═══════════════════════════════════════════════════════
// Taupunkt errechnen
// ═══════════════════════════════════════════════════════
float dewPoint(float temp, float hum) {
  const float a = 17.62f;
  const float b = 243.12f;
  float gamma = log(hum / 100.0f) + (a * temp) / (b + temp);
  return (b * gamma) / (a - gamma);
}

// ═══════════════════════════════════════════════════════
// BAROMETER
// ═══════════════════════════════════════════════════════
void updateBarometer(float currentPressure) {
  if (isnan(currentPressure)) return;
  
  time_t now = time(nullptr);
  struct tm* tm_info = localtime(&now);
  if (!tm_info) return;
  int currentHour = tm_info->tm_hour;
  
  if (lastHour >= 0 && currentHour != lastHour) {
    if (pressureCount > 0) {
      float finishedHourValue = pressureSum / pressureCount;
      hourlyValue_minus2 = hourlyValue_minus1;
      hourlyValue_minus1 = finishedHourValue;
    }
    pressureSum = 0.0f;
    pressureCount = 0;
  }
  
  lastHour = currentHour;
  pressureSum += currentPressure;
  pressureCount++;
  currentHourlyValue = pressureSum / pressureCount;
}

bool baroReady() {
  return (!isnan(currentHourlyValue) && !isnan(hourlyValue_minus2));
}

int calcBaroTrend() {
  if (!baroReady()) return -999;
  float diff = currentHourlyValue - hourlyValue_minus2;
  if (diff > 2.0f) return 3;
  if (diff > 1.0f) return 2;
  if (diff > 0.5f) return 1;
  if (diff < -2.0f) return -3;
  if (diff < -1.0f) return -2;
  if (diff < -0.5f) return -1;
  return 0;
}

String baroIcons(int trend) {
  const char* gray = "⚪️";
  
  // Keine Daten vorhanden → alles grau
  if (trend == -999) {
    String out = "➖ ";
    for (int i = 0; i < 7; i++) {
      out += gray;
      if (i < 6) out += " ";
    }
    out += " ➕";
    return out;
  }
  
  // Normale Anzeige mit Daten
  if (trend < -3) trend = -3;
  if (trend > 3)  trend =  3;
  const char* colored[7] = {"🔴","🟠","🟡","🔵","🟡","🟠","🔴"};
  const int center = 3;
  const int active = center + trend;
  String out = "➖ ";
  for (int i = 0; i < 7; i++) {
    bool isCenter = (i == center);
    bool isActive = (i == active);
    if (isCenter || isActive) {
      out += colored[i];
    } else {
      out += gray;
    }
    if (i < 6) out += " ";
  }
  out += " ➕";
  return out;
}
// ═══════════════════════════════════════════════════════
// WETTERWARNUNG
// ═══════════════════════════════════════════════════════
int calculateWeatherWarning(float temp, float hum, float dew, int baroTrend) {
  if (temp >= -1.0f && temp <= 4.0f && hum > 75.0f) {
    return 4;
  }
  if (temp < 2.0f && hum > 85.0f && baroTrend < 0) {
    return 2;
  }
  float tempDewDiff = temp - dew;
  if (tempDewDiff < 2.5f && hum > 90.0f) {
    return 3;
  }
  if (hum > 85.0f && baroTrend < 0) {
    return 1;
  }
  return 0;
}

